#: front/config.form.php:24
msgid "Field Lock"
msgstr "Bloqueio de Campos"

#: front/config.form.php:66
msgid "Select at least one profile to start locking fields."
msgstr "Selecione ao menos um perfil para começar a bloquear campos."

#: front/config.form.php:67
msgid "Loading form…"
msgstr "Carregando formulário…"

#: front/config.form.php:68
msgid "locked field(s)"
msgstr "campo(s) bloqueado(s)"

#: front/config.form.php:69
msgid "Saved"
msgstr "Salvo"

#: front/config.form.php:70
msgid "Could not save the change"
msgstr "Não foi possível salvar a alteração"

#: front/config.form.php:71
msgid "Remove every lock on this form for the selected profiles?"
msgstr "Remover todos os bloqueios deste formulário para os perfis selecionados?"

#: front/config.form.php:72
msgid "Locked for some of the selected profiles only"
msgstr "Bloqueado apenas para alguns dos perfis selecionados"

#: front/config.form.php:73
msgid "This form has no field that can be locked."
msgstr "Este formulário não possui nenhum campo que possa ser bloqueado."

#: front/config.form.php:74
#, php-format
msgid "This form only exists for a saved item. Enter an existing %s ID above."
msgstr "Este formulário só existe para um item salvo. Informe acima o ID de um registro de %s existente."

#: front/config.form.php:75
#, php-format
msgid "GLPI refused to render this form (HTTP %s)."
msgstr "O GLPI recusou-se a exibir este formulário (HTTP %s)."

#: front/config.form.php:76
#, php-format
msgid "Belongs to %s, not to the selected form"
msgstr "Pertence a %s, não ao formulário selecionado"

#: front/config.form.php:95
msgid "Profiles to configure"
msgstr "Perfis a configurar"

#: front/config.form.php:106
msgid "Locks are applied to every selected profile at once."
msgstr "Os bloqueios são aplicados a todos os perfis selecionados de uma vez."

#: front/config.form.php:110
msgid "Lock mode"
msgstr "Modo de bloqueio"

#: front/config.form.php:141
msgid "Item ID"
msgstr "ID do item"

#: front/config.form.php:145
msgid "new item"
msgstr "novo item"

#: front/config.form.php:147
msgid "Leave empty for the creation form. Fill it to reach fields that only exist on a saved item."
msgstr "Deixe em branco para o formulário de criação. Preencha para acessar campos que só existem em um item salvo."

#: front/config.form.php:154
msgid "Reload preview"
msgstr "Recarregar pré-visualização"

#: front/config.form.php:157
msgid "Clear locks on this form"
msgstr "Limpar bloqueios deste formulário"

#: front/config.form.php:167
msgid "Form preview"
msgstr "Pré-visualização do formulário"

#: inc/lock.class.php:29
msgid "Field lock"
msgstr "Bloqueio de campo"

#: inc/lock.class.php:35
msgid "Read-only (greyed out)"
msgstr "Somente leitura (esmaecido)"

#: inc/lock.class.php:36
msgid "Hidden"
msgstr "Oculto"

#: inc/lock.class.php:409
#, php-format
msgid "Table %s created"
msgstr "Tabela %s criada"
